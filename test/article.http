@baseUrl = http://localhost:4000

### 로그인 (게시글 등록자 역할 - seed 데이터 alice)
# @name signInOwner
POST {{baseUrl}}/auth/signIn
Content-Type: application/json

{
  "email": "alice@example.com",
  "password": "password123!"
}

###
# 우리 API는 accessToken을 응답 body가 아니라 httpOnly 쿠키로만 내려줘서,
# Set-Cookie 헤더를 그대로 캡처해서 이후 요청의 Cookie 헤더로 명시적으로 붙여줌
# (REST Client의 자동 쿠키 저장은 alice/bob 로그인이 서로 덮어써서 소유권 테스트가 깨짐)
@ownerCookie = {{signInOwner.response.headers.Set-Cookie}}

### 로그인 (다른 사용자 역할 - 소유권 인가 테스트용, seed 데이터 bob)
# @name signInOther
POST {{baseUrl}}/auth/signIn
Content-Type: application/json

{
  "email": "bob@example.com",
  "password": "password123!"
}

###
@otherCookie = {{signInOther.response.headers.Set-Cookie}}

### 요구사항(게시글 등록): 필수 필드 유효성 검증 실패 -> 400
POST {{baseUrl}}/articles
Cookie: {{ownerCookie}}
Content-Type: application/json

{
  "title": "",
  "content": ""
}

### 요구사항(게시글 기능 인가): 로그인하지 않은 사용자는 게시글 등록 불가 -> 401
POST {{baseUrl}}/articles
Content-Type: application/json

{
  "title": "테스트 게시글",
  "content": "내용입니다"
}

### 요구사항(게시글 등록): 로그인한 사용자는 게시글 등록 가능 -> 201
# @name createArticle
POST {{baseUrl}}/articles
Cookie: {{ownerCookie}}
Content-Type: application/json

{
  "title": "테스트 게시글",
  "content": "내용입니다"
}

###
@articleId = {{createArticle.response.body.data.id}}

### 게시글 목록 조회 (offset 페이지네이션 + 최신순 정렬)
GET {{baseUrl}}/articles?sort=recent&page=1&limit=10

### 게시글 목록 조회 (title/content 검색)
GET {{baseUrl}}/articles?search=테스트

### 요구사항(게시글 상세): 비로그인 조회 -> isLiked: false, 댓글 리스트 포함
GET {{baseUrl}}/articles/{{articleId}}

### 요구사항(게시글 상세): 로그인 조회 -> isLiked 여부 반영
GET {{baseUrl}}/articles/{{articleId}}
Cookie: {{ownerCookie}}

### 존재하지 않는 게시글 조회 -> 404
GET {{baseUrl}}/articles/999999

### 요구사항(게시글 기능 인가): 등록한 사용자만 수정 가능 -> 본인 소유 200
PATCH {{baseUrl}}/articles/{{articleId}}
Cookie: {{ownerCookie}}
Content-Type: application/json

{
  "content": "수정된 내용입니다"
}

### 요구사항(게시글 기능 인가): 등록하지 않은 사용자의 수정 시도
# -> 참고: 지금 article 라우터는 PATCH에 인가 미들웨어가 없어서 누구나 수정 가능 (403 아님)
PATCH {{baseUrl}}/articles/{{articleId}}
Cookie: {{otherCookie}}
Content-Type: application/json

{
  "content": "남의 게시글 수정 시도"
}

### 로그인하지 않은 사용자의 수정 시도
# -> 참고: 위와 동일한 이유로 401도 아니고 그냥 수정됨
PATCH {{baseUrl}}/articles/{{articleId}}
Content-Type: application/json

{
  "content": "수정 시도"
}

### 요구사항(댓글 기능 인가): 로그인한 사용자만 게시글에 댓글 등록 가능
# @name createArticleComment
POST {{baseUrl}}/articles/{{articleId}}/comments
Cookie: {{otherCookie}}
Content-Type: application/json

{
  "content": "댓글 테스트입니다"
}

### 로그인하지 않은 사용자의 댓글 등록 시도 -> 401
POST {{baseUrl}}/articles/{{articleId}}/comments
Content-Type: application/json

{
  "content": "댓글 테스트입니다"
}

### 게시글 댓글 목록 조회 (writer 정보 포함)
GET {{baseUrl}}/articles/{{articleId}}/comments

###
@commentId = {{createArticleComment.response.body.id}}

### 요구사항(댓글 기능 인가): 댓글을 등록한 사용자만 수정 가능 -> 본인 200
PATCH {{baseUrl}}/comments/{{commentId}}
Cookie: {{otherCookie}}
Content-Type: application/json

{
  "content": "수정된 댓글"
}

### 요구사항(댓글 기능 인가): 등록하지 않은 사용자의 수정 시도 -> 403
PATCH {{baseUrl}}/comments/{{commentId}}
Cookie: {{ownerCookie}}
Content-Type: application/json

{
  "content": "남의 댓글 수정 시도"
}

### 요구사항(댓글 기능 인가): 등록하지 않은 사용자의 삭제 시도 -> 403
DELETE {{baseUrl}}/comments/{{commentId}}
Cookie: {{ownerCookie}}

### 댓글 삭제 (작성자 본인) -> 204
DELETE {{baseUrl}}/comments/{{commentId}}
Cookie: {{otherCookie}}

### 요구사항(게시글 삭제)
# -> 참고: article 라우터는 DELETE에도 인가 미들웨어가 없어서 누구나(bob도) 삭제 가능
DELETE {{baseUrl}}/articles/{{articleId}}
Cookie: {{otherCookie}}

### 삭제된(존재하지 않는) 게시글 삭제 시도 -> 404
DELETE {{baseUrl}}/articles/{{articleId}}
Cookie: {{ownerCookie}}
