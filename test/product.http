@baseUrl = http://localhost:3000

### 로그인 (상품 등록자 역할 - seed 데이터 alice)
# @name signInOwner
POST {{baseUrl}}/auth/signIn
Content-Type: application/json

{
  "email": "test07072@example.com",
  "password": "password1234!"
}

# @ownerToken = {{signInOwner.response.body.accessToken}}

### 로그인 (다른 사용자 역할 - 소유권 인가 테스트용, seed 데이터 bob)
# @name signInOther
POST {{baseUrl}}/auth/signIn
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "password1234!"
}

@ownerToken = {{signInOther.response.body.accessToken}}

### 요구사항(상품 등록): 필수 필드 유효성 검증 실패 -> 400
POST {{baseUrl}}/products
Authorization: Bearer {{ownerToken}}
Content-Type: application/json

{
  "name": "",
  "description": "",
  "price": -100
}

### 요구사항(상품 기능 인가): 로그인하지 않은 사용자는 상품 등록 불가 -> 401
POST {{baseUrl}}/products
Content-Type: application/json

{
  "name": "테스트 상품",
  "description": "상품 설명입니다",
  "price": 10000
}

### 요구사항(상품 등록): 로그인한 사용자는 상품 등록 가능 -> 201
# @name createProduct
POST {{baseUrl}}/products
Authorization: Bearer {{ownerToken}}
Content-Type: application/json

{
  "name": "테스트 상품",
  "description": "상품 설명입니다",
  "price": 10000,
  "tags": ["전자제품", "테스트"],
  "images": ["/uploads/sample.jpg"]
}

@productId = {{createProduct.response.body.id}}

### 요구사항(이미지 업로드): multer로 이미지 저장 후 경로 반환
# -> ./sample.jpg 자리에 실제 로컬 이미지 파일 경로를 넣어야 동작합니다
POST {{baseUrl}}/images/upload
Authorization: Bearer {{ownerToken}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="image"; filename="sample.jpg"
Content-Type: image/jpeg

< ./sample.jpg
--boundary--

### 상품 목록 조회 (offset 페이지네이션 + 최신순 정렬)
GET {{baseUrl}}/products?sort=recent&page=1&limit=10

### 상품 목록 조회 (name/description 검색)
GET {{baseUrl}}/products?search=테스트

### 요구사항(상품 상세): 비로그인 조회 -> isFavorite: false, 댓글 리스트 포함
GET {{baseUrl}}/products/{{productId}}

### 요구사항(상품 상세): 로그인 조회 -> isFavorite 여부 반영
GET {{baseUrl}}/products/{{productId}}
Authorization: Bearer {{ownerToken}}

### 존재하지 않는 상품 조회 -> 404
GET {{baseUrl}}/products/999999

### 요구사항(상품 기능 인가): 등록한 사용자만 수정 가능 -> 본인 소유 200
PATCH {{baseUrl}}/products/{{productId}}
Authorization: Bearer {{ownerToken}}
Content-Type: application/json

{
  "price": 9000
}

### 요구사항(상품 기능 인가): 등록하지 않은 사용자의 수정 시도 -> 403
PATCH {{baseUrl}}/products/{{productId}}
Authorization: Bearer {{otherToken}}
Content-Type: application/json

{
  "price": 1
}

### 요구사항(상품 기능 인가): 로그인하지 않은 사용자의 수정 시도 -> 401
PATCH {{baseUrl}}/products/{{productId}}
Content-Type: application/json

{
  "price": 1
}

### 요구사항(좋아요 기능): 로그인한 사용자만 좋아요(favorite) 가능
POST {{baseUrl}}/products/{{productId}}/favorite
Authorization: Bearer {{otherToken}}

### 좋아요 중복 등록 -> 400 (unique 제약 위반)
POST {{baseUrl}}/products/{{productId}}/favorite
Authorization: Bearer {{otherToken}}

### 좋아요한 상태에서 상세 조회 -> isFavorite: true
GET {{baseUrl}}/products/{{productId}}
Authorization: Bearer {{otherToken}}

### 내가 좋아요한 상품 목록
GET {{baseUrl}}/users/me/favorites
Authorization: Bearer {{otherToken}}

### 요구사항(좋아요 기능): 좋아요 취소
DELETE {{baseUrl}}/products/{{productId}}/favorite
Authorization: Bearer {{otherToken}}

### 로그인하지 않은 사용자의 좋아요 시도 -> 401
POST {{baseUrl}}/products/{{productId}}/favorite

### 로그인하지 않은 사용자의 좋아요 취소 시도 -> 401
DELETE {{baseUrl}}/products/{{productId}}/favorite

### 요구사항(댓글 기능 인가): 로그인한 사용자만 상품에 댓글 등록 가능
# @name createProductComment
POST {{baseUrl}}/products/{{productId}}/comments
Authorization: Bearer {{otherToken}}
Content-Type: application/json

{
  "content": "댓글 테스트입니다"
}

### 로그인하지 않은 사용자의 댓글 등록 시도 -> 401
POST {{baseUrl}}/products/{{productId}}/comments
Content-Type: application/json

{
  "content": "댓글 테스트입니다"
}

### 상품 댓글 목록 조회 (writer 정보 포함)
GET {{baseUrl}}/products/{{productId}}/comments

@commentId = {{createProductComment.response.body.id}}

### 요구사항(댓글 기능 인가): 댓글을 등록한 사용자만 수정 가능 -> 본인 200
PATCH {{baseUrl}}/comments/{{commentId}}
Authorization: Bearer {{otherToken}}
Content-Type: application/json

{
  "content": "수정된 댓글"
}

### 요구사항(댓글 기능 인가): 등록하지 않은 사용자의 수정 시도 -> 403
PATCH {{baseUrl}}/comments/{{commentId}}
Authorization: Bearer {{ownerToken}}
Content-Type: application/json

{
  "content": "남의 댓글 수정 시도"
}

### 요구사항(댓글 기능 인가): 등록하지 않은 사용자의 삭제 시도 -> 403
DELETE {{baseUrl}}/comments/{{commentId}}
Authorization: Bearer {{ownerToken}}

### 댓글 삭제 (작성자 본인) -> 204
DELETE {{baseUrl}}/comments/{{commentId}}
Authorization: Bearer {{otherToken}}

### 요구사항(상품 기능 인가): 등록하지 않은 사용자의 삭제 시도 -> 403
DELETE {{baseUrl}}/products/{{productId}}
Authorization: Bearer {{otherToken}}

### 요구사항(상품 등록): 등록한 사용자의 삭제 -> 204
DELETE {{baseUrl}}/products/{{productId}}
Authorization: Bearer {{ownerToken}}

### 삭제된(존재하지 않는) 상품 삭제 시도 -> 404
DELETE {{baseUrl}}/products/{{productId}}
Authorization: Bearer {{ownerToken}}
