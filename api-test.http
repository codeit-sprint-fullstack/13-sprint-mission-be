@baceUrl = http://localhost:3000
# 이전 배포 URL https://one3-sprint-mission-be.onrender.com

### 상품 등록
POST {{baceUrl}}/products
Content-Type: application/json

{
  "name": "티셔츠",
  "description": "아주 좋은 티셔츠입니다",
  "price": 5000,
  "tags": ["의류", "티셔츠"]
}
### 상품 수정
PATCH {{baceUrl}}/products/69hbe75d84a38ced7745a87f
Content-Type: application/json

{
  "name": "의자",
  "description": "아주 튼튼한 의자입니다",
  "price": 600000,
  "tags": ["가구"]
}
### 상품 조회
GET {{baceUrl}}/products

### 상품 정렬
GET {{baceUrl}}/products?page=1&pageSize=5&orderBy=recent

### 상품 검색
GET {{baceUrl}}/products?page=1&pageSize=5&orderBy=recent&keyword=튼

### 상품 삭제
DELETE {{baceUrl}}/products/32

### 게시글 등록
POST {{baceUrl}}/articles
Content-Type: application/json

{
  "title": "맥북 16인치 16기가 1테라 정도 사양이면 얼마에 팔아야하나요?",
  "content": "맥북 16인치 16기가 1테라 정도 사양이면 얼마에 팔아야하나요?",
  "userId": 1
}

### 게시글 조회
GET {{baceUrl}}/articles

### 게시글 상세 페이지 조회
GET {{baceUrl}}/articles/1

### 게시글 수정
PATCH {{baceUrl}}/articles/1
Content-Type: application/json

{
  "title": "수정 맥북 16인치 16기가 1테라 정도 사양이면 얼마에 팔아야하나요?",
  "content": "수정수정 맥북 16인치 16기가 1테라 정도 사양이면 얼마에 팔아야하나요?",
  "userId": 1
}

### 게시글 댓글 등록
POST {{baceUrl}}/articles/1/comments
Content-Type: application/json

{
  "content": "혹시 사용기간이 어떻게 되실까요?",
  "type": "article",
  "articleId": 1,
  "userId": 1
}

### 게시글 댓글 목록 조회
GET {{baceUrl}}/articles/1/comments

### 댓글 수정
PATCH {{baceUrl}}/articles/1/comments/1
Content-Type: application/json

{
  "content": "수정 혹시 사용기간이 어떻게 되실까요?",
  "type": "article",
  "articleId": 1,
  "userId": 1
}