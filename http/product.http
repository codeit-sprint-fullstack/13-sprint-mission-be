@localUrl = http://localhost:3002

### 로그인 (토큰 발급)
# @name login
POST {{localUrl}}/auth/login
Content-Type: application/json

{
  "email": "test@test.com",
  "password": "test1234"
}

###
@accessToken = {{login.response.body.accessToken}}

### 상품 목록 조회
GET {{localUrl}}/products

### 상품 목록 조회 (검색 + 페이지네이션 + 정렬)
GET {{localUrl}}/products?keyword=축구공&page=1&pageSize=10&orderBy=recent

### 상품 등록
# @name createProduct
POST {{localUrl}}/products
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "name": "축구공",
  "price": 30000,
  "description": "이것만 사면 나도 축구왕?????",
  "tags": ["4팀", "123", "스트라이커"]
}

###
@productId = {{createProduct.response.body.data.id}}

### 상품 상세 조회
GET {{localUrl}}/products/{{productId}}

### 상품 수정
PATCH {{localUrl}}/products/{{productId}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "name": "축구공2",
  "price": 35000
}

### 상품 좋아요
POST {{localUrl}}/products/{{productId}}/like
Authorization: Bearer {{accessToken}}

### 상품 좋아요 취소
DELETE {{localUrl}}/products/{{productId}}/like
Authorization: Bearer {{accessToken}}

### 이미지 업로드 (http 폴더에 sample.jpg 준비 필요)
POST {{localUrl}}/products/images
Content-Type: multipart/form-data; boundary=boundary
Authorization: Bearer {{accessToken}}

--boundary
Content-Disposition: form-data; name="images"; filename="sample.jpg"
Content-Type: image/jpeg

< ./sample.jpg
--boundary--

### 상품 삭제
DELETE {{localUrl}}/products/{{productId}}
Authorization: Bearer {{accessToken}}
