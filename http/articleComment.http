@localUrl = http://localhost:3002

### 로그인 (토큰 발급)
# @name login
POST {{localUrl}}/auth/login
Content-Type: application/json

{
  "email": "test@test.com",
  "password": "test1234"
}

###
@accessToken = {{login.response.body.accessToken}}

### 댓글 테스트용 게시글 생성
# @name createArticle
POST {{localUrl}}/articles
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "title": "댓글테스트",
  "content": "댓글 테스트용 게시글입니다."
}

###
@articleId = {{createArticle.response.body.data.id}}

### 댓글 등록
# @name createComment
POST {{localUrl}}/articles/{{articleId}}/comments
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "content": "좋은 글이네요!"
}

###
@commentId = {{createComment.response.body.data.id}}

### 댓글 목록 조회
GET {{localUrl}}/articles/{{articleId}}/comments

### 댓글 목록 조회 (페이지네이션)
GET {{localUrl}}/articles/{{articleId}}/comments?pageSize=5

### 댓글 수정
PATCH {{localUrl}}/articles/comments/{{commentId}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "content": "수정된 댓글입니다."
}

### 댓글 삭제
DELETE {{localUrl}}/articles/comments/{{commentId}}
Authorization: Bearer {{accessToken}}
