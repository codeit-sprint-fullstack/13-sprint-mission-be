@localUrl = http://localhost:3000


### 게시물 조회
GET {{localUrl}}/article


### 게시물 목록 조회
GET {{localUrl}}/articles?keyword=Porro 


### 
GET  {{localUrl}}/articles/3hUdYIywI-NWFIvaqL6oR


### 상품 삭제
DELETE {{localUrl}}/articles/gACX8TyyT8VNRPGGXO0si

### 상품 등록
POST {{localUrl}}/articles
Content-Type: application/json

{
  "title": "한글로된 타이틀",
  "content": "이것은 내용입니다만 무슨 문제라도?"
}


### 상품 수정
PATCH  {{localUrl}}/articles/gACX8TyyT8VNRPGGXO0si
Content-Type: application/json    

{
  "name": "축구공3",
  "price": 100000,
  "description": "콘푸라이 차차차찿차차ㅏ 타잔이요",
  "tags": ["#4팀", "#화이팅", "#김대영"]
}