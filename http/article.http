@localUrl = http://localhost:3002

### 로그인 (토큰 발급)
# @name login
POST {{localUrl}}/auth/login
Content-Type: application/json

{
  "email": "test@test.com",
  "password": "test1234"
}

###
@accessToken = {{login.response.body.accessToken}}

### 게시글 목록 조회
GET {{localUrl}}/articles

### 게시글 목록 조회 (검색 + 페이지네이션 + 정렬)
GET {{localUrl}}/articles?keyword=타이틀&page=1&pageSize=10&orderBy=recent

### 게시글 등록
# @name createArticle
POST {{localUrl}}/articles
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "title": "테스트 타이틀",
  "content": "이것은 테스트용 게시글 내용입니다."
}

###
@articleId = {{createArticle.response.body.data.id}}

### 게시글 상세 조회
GET {{localUrl}}/articles/{{articleId}}

### 게시글 수정
PATCH {{localUrl}}/articles/{{articleId}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "title": "수정된 타이틀",
  "content": "수정된 내용입니다."
}

### 게시글 좋아요
POST {{localUrl}}/articles/{{articleId}}/like
Authorization: Bearer {{accessToken}}

### 게시글 좋아요 취소
DELETE {{localUrl}}/articles/{{articleId}}/like
Authorization: Bearer {{accessToken}}

### 게시글 삭제
DELETE {{localUrl}}/articles/{{articleId}}
Authorization: Bearer {{accessToken}}
