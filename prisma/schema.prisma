// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}
model User {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// 1. Article (게시글) 모델
model Article {
  id        Int       @id @default(autoincrement())
  title     String    @db.VarChar(255)
  content   String    @db.Text
  createdAt DateTime  @default(now()) @db.Timestamp(3) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @db.Timestamp(3) @map("updated_at")
 
  // 관계 설정: 하나의 게시글은 여러 개의 댓글을 가질 수 있음 (1:N)
  comments  Comment[]

  @@map("article")
}



// 2. Comment (댓글) 모델
model Comment {
  id        Int      @id @default(autoincrement())
  articleId Int      @map("article_id")
  content   String   @db.Text
  createdAt DateTime @default(now()) @db.Timestamp(3) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamp(3) @map("updated_at")

  // 외래키 및 Cascade 설정
  // onDelete: Cascade, onUpdate: Cascade가 적용되어 부모(Article)가 삭제/수정될 때 함께 연동됩니다.
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("comment")
}

