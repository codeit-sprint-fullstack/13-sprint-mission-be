@baseURL = http://localhost:3000

###상품 등록
POST {{baseURL}}/products
Content-Type: application/json

{
    "name": "맥북에어",
    "description": "맥북에어 M1입니다",
    "price": 500000,
    "tags":"전자제품"
}

###상품 전체 조회
GET {{baseURL}}/products
###상품 id 조회
GET {{baseURL}}/products/73

###상품 검색(이름)
GET {{baseURL}}/products?keyword=맥북


###이름순 정렬
GET {{baseURL}}/products?sort=name




###상품 수정
PATCH {{baseURL}}/products/70
Content-Type: application/json

{
  "price": 50000
}

###상품 삭제
DELETE {{baseURL}}/products/51