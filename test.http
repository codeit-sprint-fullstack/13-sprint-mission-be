@baseUrl = http://localhost:3000

###
GET {{baseUrl}}/products 

### product 생성
POST  {{baseUrl}}/products
Content-Type: application/json

{
  "name": "맥북",
  "description": "상태 좋은 중고 맥북",
  "price": 1200000,
  "tags": ["전자기기", "노트북"]
}

### product 상세 조회
GET {{baseUrl}}/products/1

### Product 수정
PATCH {{baseUrl}}/products/1
Content-Type: application/json

{
  "price": 1000000
}

### Product 삭제
DELETE {{baseUrl}}/products/1


### Article 생성
POST {{baseUrl}}/articles
Content-Type: application/json

{
  "title": "첫 번째 게시글",
  "content": "게시글 내용입니다."
}

###
GET {{baseUrl}}/articles

### Article 수정
PATCH  {{baseUrl}}/articles/2
Content-Type: application/json

{
  "title": "수정된 제목",
  "content": "수정된 내용"
}

###
DELETE {{baseUrl}}/articles/2

###
GET {{baseUrl}}/articles?keyword=맥북

###
GET {{baseUrl}}/articles?offset=0&limit=5

###
GET {{baseUrl}}/articles?orderBy=recent

### 댓글 등록
POST {{baseUrl}}/articles/1/comments
Content-Type: application/json

{
  "content": "댓글 테스트입니다."
}

### Article 댓글 목록 조회
GET {{baseUrl}}/articles/2/comments

### Article 댓글 목록 조회 - cursor pagination
GET {{baseUrl}}/articles/2/comments?limit=5&cursor=5

### Article 댓글 수정
PATCH  {{baseUrl}}/articles/comments/2
Content-Type: application/json

{
  "content": "수정된 댓글입니다."
}

### Article 댓글 삭제
DELETE {{baseUrl}}/articles/comments/2

###
GET {{baseUrl}}/products/21/comments
### 
POST {{baseUrl}}/products/7/comments
Content-Type: application/json

{
  "content": "혹시 사용기간이 어떻게 되실까요?"
}

### Product 댓글 수정
PATCH {{baseUrl}}/products/comments/5
Content-Type: application/json

{
  "content": "수정된 상품 댓글입니다."
}

### ### Product 댓글 삭제
DELETE {{baseUrl}}/products/comments/5