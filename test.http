Content-Type: application/json

{
  "content":"상품에 댓글 추추추가"
}

###

PATCH {{BASE_URL}}/articles/87/comments/1
Content-Type: application/json

{
  "content":"첫 게시글 댓글 수정"
}

###article patch
PATCH {{BASE_URL}}/articles/1
Content-Type: application/json

{
  "title":"첫번째 게시글 제목 수정",
  "content":"첫번째 게시글 내용 수정"
}

