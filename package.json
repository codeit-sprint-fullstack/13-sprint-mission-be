{
  "name": "sprint-be",
  "version": "1.0.0",
  "description": "13BE스프린트",
  "main": "app.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/app.js",
    "start": "cross-env NODE_ENV=production node src/app.js",
    "build": "npx prisma generate",
    "db:migrate": "dotenv -e .env.development -- npx prisma migrate dev",
    "db:migrate:deploy": "dotenv -e .env.production -- npx prisma migrate deploy",
    "db:reset": "dotenv -e .env.development -- npx prisma migrate reset",
    "db:push": "dotenv -e .env.development -- npx prisma db push",
    "db:seed": "dotenv -e .env.development -- node prisma/seed.js",
    "db:studio": "dotenv -e .env.development -- npx prisma studio"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "faker": "^6.6.6",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.5.0",
    "multer": "^2.2.0",
    "nanoid": "^5.1.9",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "nodemon": "^3.1.14",
    "prisma": "^6.19.3"
  }
}
