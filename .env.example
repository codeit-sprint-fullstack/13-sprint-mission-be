# 공통 (개발/배포 모두 필요)
DATABASE_URL="postgresql://유저:비번@localhost:5432/panda?schema=public"
JWT_SECRET="아무도_모르는_긴_문자열"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:3001"
PORT=3000

# 업로드 저장소: local | s3
# 지정하지 않으면 S3_BUCKET이 있을 때 s3, 없으면 local로 동작한다.
UPLOAD_DRIVER="local"

# AWS (UPLOAD_DRIVER=s3 일 때 필요)
AWS_REGION="ap-northeast-2"
S3_BUCKET="panda-market-images-내이름"
S3_PRESIGN_EXPIRES=300

# 로컬에서 S3를 테스트할 때만 사용한다.
# EC2에서는 IAM Role로 자격 증명을 받으므로 아래 두 줄을 넣지 않는다.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
