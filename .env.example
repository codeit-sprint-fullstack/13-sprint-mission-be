# API 서버 기본 주소 (공유받은 주소를 입력하세요)
VITE_API_BASE_URL=http://localhost:3000

# 프로덕션 도메인 주소
CLIENT_URL=http://localhost:3000

# MongoDB Atlas 연결 문자열을 여기에 붙여넣으세요.
# 예: mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/todo-app
MONGODB_URI=여기에_mongodb_연결_주소를_입력하세요

# 서버가 열릴 포트 번호 (기본 3000)
PORT=3000
