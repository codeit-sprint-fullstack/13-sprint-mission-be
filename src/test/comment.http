@baseUrl = http://localhost:3000/articles/1/comments

### POST Comment 테스트
POST {{baseUrl}}
Content-Type: application/json

{
    "content": "오 해볼게요 입문으로 좋은 캐 뭐가 있나요?",
    "userId": 1
}

POST {{baseUrl}}
Content-Type: application/json

{
    "content": "아아....탱은.....뉴비가 하기 힘들죠",
    "userId": 3
}

POST http://localhost:3000/articles/1000/comments
Content-Type: application/json

{
    "content": "똥탱",
    "userId": 4
}

POST http://localhost:3000/articles/1/comments
Content-Type: application/json

{
    "content": "",
    "userId": 4
}


### GET Comment 테스트
GET {{baseUrl}}
GET http://localhost:3000/articles/10000/comments
GET {{baseUrl}}?cursor=1

### PATCH Article 테스트
PATCH {{baseUrl}}/4
Content-Type: application/json

{
    "content": "오버워치지~!!!!!!!!!!!"
}

PATCH {{baseUrl}}/4000
Content-Type: application/json

{
    "content": "오버워치지~!!!!!!!!!!!"
}

