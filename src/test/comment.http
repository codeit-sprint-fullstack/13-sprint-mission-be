Content-Type: application/json

{
    "content": "오버워치지~!!!!!!!!!!!"
}

PATCH http://localhost:3000/articles/1000/comments/4
Content-Type: application/json

{
    "content": "오버워치지~!!!!!!!!!!!"
}

